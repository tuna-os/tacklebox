# Native ARM64 CI fixture only. This is not a production bootc image.
FROM registry.fedoraproject.org/fedora@sha256:e9a729f7460456b44cd812f451858bfc990d420be59ded9fce1888aeb2ab7e03

COPY build.sh pins.json /fixture/

# Bootstrap trust is the digest-pinned Fedora image and its Fedora signing key.
# Dependencies deliberately resolve from these official Fedora repositories.
# Capture their actual metadata/transaction; do not call them transitively pinned.
RUN mkdir -p /fixture/repos.d /fixture/evidence /fixture/bootstrap-repodata && \
    printf '%s\n' \
      '[fedora]' \
      'name=Fedora45 official release' \
      'baseurl=https://dl.fedoraproject.org/pub/fedora/linux/releases/45/Everything/aarch64/os/' \
      'enabled=1' 'gpgcheck=1' 'sslverify=1' \
      'gpgkey=file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-fedora-45-primary' \
      '[updates]' \
      'name=Fedora45 official updates' \
      'baseurl=https://dl.fedoraproject.org/pub/fedora/linux/updates/45/Everything/aarch64/' \
      'enabled=1' 'gpgcheck=1' 'sslverify=1' \
      'gpgkey=file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-fedora-45-primary' \
      > /fixture/repos.d/fedora.repo && \
    rpm -qa --qf '%{NAME}\t%{EPOCHNUM}\t%{VERSION}\t%{RELEASE}\t%{ARCH}\t%{SOURCERPM}\n' \
      | sort > /fixture/evidence/base-installed.tsv && \
    ulimit -f 2097152 && \
    (dnf -y --releasever=45 --setopt=reposdir=/fixture/repos.d \
      --setopt=keepcache=True --setopt=install_weak_deps=False \
      --setopt=timeout=30 --setopt=retries=2 --setopt=max_parallel_downloads=2 \
      install python3 gnupg2 curl rpm-sign kmod xz zstd findutils util-linux \
      > /fixture/evidence/bootstrap-dnf.log 2>&1 || \
      { status=$?; tail -c 16384 /fixture/evidence/bootstrap-dnf.log >&2; exit "$status"; }) && \
    /bin/bash /fixture/build.sh _install

ENV LC_ALL=C HOME=/tmp
ENTRYPOINT ["/bin/bash", "/fixture/build.sh"]
